# Supabase project credentials (https://app.supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Default UI language: uz | en | ru
VITE_DEFAULT_LOCALE=uz

# Server-side only (used by a backend/edge function, NEVER exposed to the client).
# Set these in your Supabase Edge Function secrets or server environment, not in
# this file if this file is ever bundled into the frontend.
# AI_PROVIDER_API_KEY=
